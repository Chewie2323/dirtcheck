# Postgres connection string.
# Neon:     postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres.PROJECTREF:password@aws-0-REGION.pooler.supabase.com:6543/postgres
# Local:        postgresql://dirtcheck:dirtcheck@127.0.0.1:5432/dirtcheck
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Signs session cookies. Required in production, at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public origin of this app. On Vercel this is optional; it falls back to the
# deployment domain.
BETTER_AUTH_URL=http://127.0.0.1:3847

# Paid Land Portal API key. Required only to use the Land Portal comps provider;
# the demo provider works without it.
LAND_PORTAL_API_KEY=

# Set to 1 to expose bundled sample parcels and demo comps in production
# (for a sales-demo deploy only). Off by default; real workspaces use Land Portal.
ALLOW_DEMO_DATA=
