# Postgres connection string.
# Neon (Vercel): postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Local:        postgresql://dirtcheck:dirtcheck@127.0.0.1:5432/dirtcheck
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Signs session cookies. Use a long random value in production.
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Public origin of this app. On Vercel, set this to the deployment URL.
BETTER_AUTH_URL=http://127.0.0.1:3847

# Optional. The Land Portal provider stays a stub until a live client is wired.
LAND_PORTAL_API_KEY=
